{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "@types/node"
    ],
    "skipLibCheck": true,
    "composite": false,
    "declaration": true,
    "noEmit": true
  },
  "include": [
    "api/**/*",
    "server/**/*"
  ]
}
